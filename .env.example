# ─── Database (app user — used at runtime, respects RLS) ─────────────────────
SPARKY_FITNESS_DB_HOST=sparkyfitness-db
SPARKY_FITNESS_DB_PORT=5432
SPARKY_FITNESS_DB_NAME=sparkyfitness
SPARKY_FITNESS_DB_USER=sparkyapp
SPARKY_FITNESS_DB_PASSWORD=changeme

# ─── Database (owner user — used for migrations/DDL only) ────────────────────
SPARKY_FITNESS_DB_OWNER_USER=sparky
SPARKY_FITNESS_DB_OWNER_PASSWORD=changeme

# ─── OAuth ───────────────────────────────────────────────────────────────────
# Public URL where claude.ai will reach this server
MCP_OAUTH_ISSUER=https://sparkymcp.yourdomain.com
# JWT signing secret (generate with: openssl rand -base64 32)
MCP_OAUTH_JWT_SECRET=generate-a-256-bit-secret-here

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
MCP_PORT=3001

# ─── Vision API (optional — leave empty to disable) ──────────────────────────
VISION_API_KEY=
VISION_API_PROVIDER=gemini

# ─── Dev Tools (requires admin role + this flag) ─────────────────────────────
DEV_TOOLS_ENABLED=false
